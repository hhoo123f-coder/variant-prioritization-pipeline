rule all:
    input:
        "results/reports/qc_report.txt",
        "results/tables/results_summary.tsv",
        "results/reports/results_summary.txt",
        "results/figures/priority_categories.png",
        "results/figures/gnomad_status.png"


rule quality_control:
    input:
        priority="data/prioritized_variants.tsv",
        annotations="data/annotations_with_SIFT_PolyPhen.tsv",
        script="scripts/qc_results.py"
    output:
        report="results/reports/qc_report.txt"
    log:
        "logs/qc.log"
    shell:
        "python scripts/qc_results.py > {output.report} 2> {log}"


rule summarize_results:
    input:
        priority="data/prioritized_variants.tsv",
        script="scripts/summarize_results.py"
    output:
        table="results/tables/results_summary.tsv",
        report="results/reports/results_summary.txt",
        priority_plot="results/figures/priority_categories.png",
        gnomad_plot="results/figures/gnomad_status.png"
    log:
        "logs/summarize_results.log"
    shell:
        "python scripts/summarize_results.py > {log} 2>&1"
